# คัดลอกไฟล์นี้เป็น config.env แล้วกรอกค่าจริง (config.env อยู่ใน .gitignore)
PROJECT_ID=my-nsl-scanner
REGION=asia-southeast1

# อีเมลที่อนุญาตให้ใช้งาน (คั่นด้วย comma) เว้นว่าง = อนุญาตทุกบัญชีที่ login ได้
ALLOWED_EMAILS=arpaket@gmail.com

# ถ้าเว้นว่าง จะใช้ค่า default = <PROJECT_ID>.appspot.com
STORAGE_BUCKET=

# ใส่เฉพาะ provider ที่จะใช้ (อันอื่นเว้นว่างได้)
CLAUDE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
